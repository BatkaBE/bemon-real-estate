{
  "name": "bemon-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.cjs",
    "export": "expo export --platform all",
    "postinstall": "node scripts/harden-dependencies.cjs"
  },
  "dependencies": {
    "expo": "57.0.26",
    "expo-auth-session": "~57.0.13",
    "expo-crypto": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
